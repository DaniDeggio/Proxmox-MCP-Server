# Proxmox API credentials
PROXMOX_TOKEN_ID=user@pam!token-name
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Pi-hole credentials (v6 password)
PIHOLE_PASSWORD=your-pihole-admin-password

# Nginx Proxy Manager credentials
NPM_USER=admin@example.com
NPM_PASSWORD=your-npm-password

# Config file path (optional, defaults to config/config.yaml)
DEGGIO_INFRA_CONFIG=config/config.yaml

# Log level override (optional)
DEGGIO_INFRA_LOG_LEVEL=INFO
