[Unit]
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Proxmox MCP Server
Documentation=https://github.com/DaniDeggio/ProxmoxMcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxmox-mcp
Group=proxmox-mcp
WorkingDirectory=/opt/proxmox-mcp-server
EnvironmentFile=/opt/proxmox-mcp-server/.env
Environment=PROXMOX_MCP_CONFIG=/opt/proxmox-mcp-server/config/config.yaml
Environment=HOME=/opt/proxmox-mcp-server/state

# Run from the virtual environment (add --transport sse --host 0.0.0.0 --port 8000 for HTTP streaming)
ExecStart=/opt/proxmox-mcp-server/.venv/bin/proxmox-mcp-server


# Restart policy
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/proxmox-mcp-server/state
PrivateTmp=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxmox-mcp-server

[Install]
WantedBy=multi-user.target
